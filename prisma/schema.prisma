generator client {
  provider = "postgresql"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  telegramId String
  username String
  firstName String
  lastName String
  pills Pill[]
  createdAt DateTime
  updatedAt DateTime
  version Int
}

model Pill {
  id Int @id @default(autoincrement())
  name String
  allCount Int
  currentCount Int
  countPerDay Int
  form String
  user User @relation(fields: [userId], references: [id])
  userId Int
  isActive Boolean @default(false)
  createdAt DateTime
  updatedAt DateTime
  version Int
}
